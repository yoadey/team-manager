{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "team-manager",
  "description": "Structural validation for helm/team-manager's values.yaml. additionalProperties: false is set on every chart-specific object (catches typo'd/unknown keys); raw pass-through Kubernetes spec fragments (securityContext, resources, affinity, tolerations, nodeSelector, annotations maps, NetworkPolicy peer selectors, imagePullSecrets) are deliberately left loosely typed since this chart doesn't interpret their internals beyond forwarding them.",
  "type": "object",
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 0 },
    "deploymentStrategy": { "type": "object" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "tag": { "type": "string" }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "name": { "type": "string" } }
      }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "automount": { "type": "boolean" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "name": { "type": "string" }
      }
    },
    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "targetPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["host", "paths"],
            "properties": {
              "host": { "type": "string" },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "pathType"],
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": { "type": "string", "enum": ["Exact", "Prefix", "ImplementationSpecific"] }
                  }
                }
              }
            }
          }
        },
        "tls": { "type": "array" }
      }
    },
    "resources": { "type": "object" },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "startupProbe": { "$ref": "#/$defs/probe" },
    "livenessProbe": { "$ref": "#/$defs/probe" },
    "readinessProbe": { "$ref": "#/$defs/probe" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": { "type": "string", "pattern": "^[0-9]+$" },
        "allowedOrigins": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "trustedProxyCidrs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "logLevel": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
        "rateLimitRps": { "type": "integer", "minimum": 1 },
        "errorTypeBaseUri": { "type": "string" },
        "apiDeprecationDate": { "type": "string" }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ttlHours": { "type": "integer", "minimum": 1 },
        "loginRateLimitPerMin": { "type": "integer", "minimum": 1 },
        "cookie": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "secure": { "type": "boolean" }
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": { "type": "boolean" },
            "existingSecret": { "type": "string" },
            "url": { "type": "string" }
          }
        }
      }
    },
    "jwt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": { "type": "boolean" },
            "existingSecret": { "type": "string" },
            "privateKey": { "type": "string" },
            "publicKey": { "type": "string" }
          }
        }
      }
    },
    "cookieEncryption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": { "type": "boolean" },
            "existingSecret": { "type": "string" },
            "key": { "type": "string" },
            "keys": { "type": "string" }
          }
        }
      }
    },
    "s3": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": { "type": "string" },
        "region": { "type": "string" },
        "bucket": { "type": "string" },
        "usePathStyle": { "type": "boolean" },
        "publicBaseUrl": { "type": "string" },
        "secret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": { "type": "boolean" },
            "existingSecret": { "type": "string" },
            "accessKeyId": { "type": "string" },
            "secretAccessKey": { "type": "string" }
          }
        }
      }
    },
    "smtp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "string", "pattern": "^[0-9]+$" },
        "fromAddress": { "type": "string" },
        "secret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": { "type": "boolean" },
            "existingSecret": { "type": "string" },
            "username": { "type": "string" },
            "password": { "type": "string" }
          }
        }
      }
    },
    "push": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publicKey": { "type": "string" },
        "subject": { "type": "string" },
        "secret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": { "type": "boolean" },
            "existingSecret": { "type": "string" },
            "privateKey": { "type": "string" }
          }
        }
      }
    },
    "selfRegistration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "emailVerificationTtlHours": { "type": "integer", "minimum": 1 },
        "registerRateLimitPerMin": { "type": "integer", "minimum": 1 },
        "resendVerificationRateLimitPerMin": { "type": "integer", "minimum": 1 }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notificationsDays": { "type": "integer", "minimum": 1 },
        "sessionsDays": { "type": "integer", "minimum": 1 },
        "auditLogDays": { "type": "integer", "minimum": 1 },
        "unverifiedAccountsDays": { "type": "integer", "minimum": 1 }
      }
    },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": { "type": "boolean" },
            "existingSecret": { "type": "string" },
            "hmacKey": { "type": "string" }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowOpen": { "type": "boolean" },
        "secret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": { "type": "boolean" },
            "existingSecret": { "type": "string" },
            "token": { "type": "string" }
          }
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "otelServiceName": { "type": "string" },
        "otelExporterEndpoint": { "type": "string" },
        "environment": { "type": "string" },
        "sentry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secret": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "create": { "type": "boolean" },
                "existingSecret": { "type": "string" },
                "dsn": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "from": { "type": "array" } }
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "postgres": { "$ref": "#/$defs/egressRule" },
            "https": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "to": { "type": "array" } }
            },
            "s3": { "$ref": "#/$defs/egressRule" },
            "smtp": { "$ref": "#/$defs/egressRule" }
          }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": "integer", "minimum": 0 }
      }
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "namespace": { "type": "string" },
        "scrapeInterval": { "type": "string" },
        "scrapeToken": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": { "type": "boolean" },
            "token": { "type": "string" },
            "existingSecretName": { "type": "string" },
            "existingSecretKey": { "type": "string" }
          }
        },
        "additionalLabels": { "type": "object", "additionalProperties": { "type": "string" } },
        "grafanaDashboard": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean" } }
        }
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "runAsInitContainer": { "type": "boolean" } }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "schedule": { "type": "string" },
        "startingDeadlineSeconds": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 0 },
        "postgresVersion": { "type": "string" },
        "postgresImageDigest": { "type": "string" },
        "dumpSizeLimit": { "type": "string" },
        "tmpSizeLimit": { "type": "string" },
        "minDumpEntries": { "type": "integer", "minimum": 0 },
        "retentionDays": { "type": "integer", "minimum": 0 },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "awsCliImage": { "type": "string" },
            "bucket": { "type": "string" },
            "prefix": { "type": "string" },
            "region": { "type": "string" },
            "endpoint": { "type": "string" },
            "credentialsSecretName": { "type": "string" }
          }
        },
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": { "type": "boolean" },
            "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
            "name": { "type": "string" }
          }
        }
      }
    }
  },
  "$defs": {
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "httpGet": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "path": { "type": "string" } }
        },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "egressRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "to": { "type": "array" }
      }
    }
  }
}
